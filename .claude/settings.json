{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go doc:*)",
      "Bash(go version:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go mod why:*)",
      "Bash(go tool gofumpt:*)",
      "Bash(gofmt:*)",
      "Bash(make build)",
      "Bash(make fmt)",
      "Bash(make vet)",
      "Bash(make tidy)",
      "Bash(make proto)",
      "Bash(make check-proto)",
      "Bash(make helm-lint)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(pre-commit run:*)",
      "Bash(pre-commit install)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "deny": [
      "Bash(golangci-lint:*)",
      "Bash(go tool golangci-lint:*)",
      "Bash(make check)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  }
}
